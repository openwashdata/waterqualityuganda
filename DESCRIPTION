Package: waterqualityuganda
Title: Drinking Water Quality from Boreholes to Household Storage in Uganda
Version: 0.0.0.9000
Authors@R: c(
    person("Cecilia", "Nansiimbi", , "nansiimbicecilia@gmail.com", role = "aut",
